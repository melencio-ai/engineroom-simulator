{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enginewatch.local/schemas/assembly.schema.json",
  "title": "Engine Watch assembly definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "status",
    "children",
    "connections",
    "exploded_steps",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "minLength": 4
    },
    "name": {
      "type": "string",
      "minLength": 5
    },
    "status": {
      "enum": [
        "illustrative",
        "catalog_documented",
        "project_approved",
        "simulation_calibrated"
      ]
    },
    "children": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "instance_id",
          "component_id",
          "translation_mm",
          "rotation_deg",
          "maintainable"
        ],
        "properties": {
          "instance_id": {
            "type": "string",
            "minLength": 2
          },
          "component_id": {
            "type": "string",
            "minLength": 4
          },
          "translation_mm": {
            "$ref": "#/$defs/vec3"
          },
          "rotation_deg": {
            "$ref": "#/$defs/vec3"
          },
          "maintainable": {
            "type": "boolean"
          }
        }
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "from",
          "to",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 2
          },
          "from": {
            "type": "string",
            "pattern": "^[^.]+\\.[^.]+$"
          },
          "to": {
            "type": "string",
            "pattern": "^[^.]+\\.[^.]+$"
          },
          "kind": {
            "enum": [
              "thread",
              "flange",
              "pipe_end",
              "shaft",
              "mount",
              "terminal",
              "signal",
              "fluid_tap"
            ]
          }
        }
      }
    },
    "exploded_steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step",
          "instance_id",
          "translation_mm",
          "prerequisites"
        ],
        "properties": {
          "step": {
            "type": "integer",
            "minimum": 1
          },
          "instance_id": {
            "type": "string",
            "minLength": 2
          },
          "translation_mm": {
            "$ref": "#/$defs/vec3"
          },
          "prerequisites": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verified",
        "reference"
      ],
      "properties": {
        "verified": {
          "type": "boolean"
        },
        "reference": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "fit_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "flanges",
        "pipes",
        "gasket",
        "fasteners",
        "joint_axis",
        "axial_tolerance_mm",
        "minimum_thread_protrusion_mm",
        "engineering_approved"
      ],
      "properties": {
        "kind": {
          "const": "flanged_pipe_joint"
        },
        "flanges": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 2,
          "maxItems": 2
        },
        "pipes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 2,
          "maxItems": 2
        },
        "gasket": {
          "type": "string",
          "minLength": 1
        },
        "joint_axis": {
          "$ref": "#/$defs/vec3"
        },
        "axial_tolerance_mm": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "minimum_thread_protrusion_mm": {
          "type": "number",
          "minimum": 0,
          "maximum": 20
        },
        "engineering_approved": {
          "const": false
        },
        "fasteners": {
          "type": "array",
          "minItems": 2,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "hole_index",
              "bolt",
              "nut",
              "near_washer",
              "far_washer"
            ],
            "properties": {
              "hole_index": {
                "type": "integer",
                "minimum": 0
              },
              "bolt": {
                "type": "string",
                "minLength": 1
              },
              "nut": {
                "type": "string",
                "minLength": 1
              },
              "near_washer": {
                "type": "string",
                "minLength": 1
              },
              "far_washer": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "vec3": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "minItems": 3,
      "maxItems": 3
    }
  }
}
