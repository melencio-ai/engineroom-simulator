{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enginewatch.local/schemas/component.schema.json",
  "title": "Engine Watch catalog component variant",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "family",
    "name",
    "revision",
    "status",
    "parameters",
    "material",
    "coating_id",
    "standards",
    "ports",
    "generator",
    "lod_policy",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9._-]{3,127}$"
    },
    "family": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 5
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "illustrative",
        "catalog_documented",
        "project_approved",
        "simulation_calibrated"
      ]
    },
    "parameters": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean",
          "null"
        ]
      },
      "properties": {},
      "minProperties": 1
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_material",
        "grade",
        "grade_standard"
      ],
      "properties": {
        "base_material": {
          "type": "string",
          "minLength": 3
        },
        "grade": {
          "type": [
            "string",
            "null"
          ]
        },
        "grade_standard": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "coating_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "insulation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "standards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "edition",
          "scope",
          "url"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 3
          },
          "edition": {
            "type": "string",
            "minLength": 4
          },
          "scope": {
            "type": "string",
            "minLength": 3
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          }
        }
      }
    },
    "ports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "interface",
          "position_mm",
          "axis"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "thread",
              "flange",
              "pipe_end",
              "shaft",
              "mount",
              "terminal",
              "signal",
              "fluid_tap",
              "inspection"
            ]
          },
          "interface": {
            "type": "string",
            "minLength": 2
          },
          "position_mm": {
            "$ref": "#/$defs/vec3"
          },
          "axis": {
            "$ref": "#/$defs/vec3"
          },
          "service": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "implementation_status"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 3
        },
        "version": {
          "type": "string",
          "minLength": 3
        },
        "implementation_status": {
          "enum": [
            "planned",
            "available"
          ]
        }
      }
    },
    "lod_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "master",
        "inspection",
        "psp_near",
        "psp_far"
      ],
      "properties": {
        "master": {
          "const": "parametric_cad"
        },
        "inspection": {
          "const": "detailed_glb"
        },
        "psp_near": {
          "enum": [
            "medium_mesh",
            "low_mesh",
            "atlas_impostor"
          ]
        },
        "psp_far": {
          "enum": [
            "low_mesh",
            "atlas_impostor",
            "omit"
          ]
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_type",
        "verified",
        "source_id",
        "reviewer",
        "field_sources"
      ],
      "properties": {
        "source_type": {
          "enum": [
            "illustrative",
            "standards_table",
            "manufacturer",
            "vessel_drawing",
            "measured"
          ]
        },
        "verified": {
          "type": "boolean"
        },
        "source_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ]
        },
        "field_sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "parameter",
              "source_id",
              "verification"
            ],
            "properties": {
              "parameter": {
                "type": "string",
                "minLength": 1
              },
              "source_id": {
                "type": "string",
                "minLength": 5
              },
              "verification": {
                "enum": [
                  "metadata_only",
                  "pending",
                  "verified"
                ]
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "vec3": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "minItems": 3,
      "maxItems": 3
    }
  }
}
