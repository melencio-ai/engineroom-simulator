{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enginewatch.local/schemas/system.schema.json",
  "title": "Engine Watch system network",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "status",
    "domain",
    "nodes",
    "edges",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "minLength": 4
    },
    "name": {
      "type": "string",
      "minLength": 5
    },
    "status": {
      "enum": [
        "illustrative",
        "catalog_documented",
        "project_approved",
        "simulation_calibrated"
      ]
    },
    "domain": {
      "enum": [
        "fluid",
        "electrical_power",
        "control_signal",
        "mechanical_drive",
        "mixed"
      ]
    },
    "nodes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "role",
          "assembly_instance",
          "port"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 2
          },
          "role": {
            "enum": [
              "tank",
              "pump",
              "valve",
              "filter",
              "cooler",
              "header",
              "bearing_load",
              "sensor",
              "bus",
              "relay",
              "terminal",
              "other"
            ]
          },
          "assembly_instance": {
            "type": [
              "string",
              "null"
            ]
          },
          "port": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "from",
          "to",
          "kind",
          "medium_id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 2
          },
          "from": {
            "type": "string",
            "minLength": 2
          },
          "to": {
            "type": "string",
            "minLength": 2
          },
          "kind": {
            "enum": [
              "fluid",
              "electrical_power",
              "control_signal",
              "mechanical_drive"
            ]
          },
          "medium_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verified",
        "reference"
      ],
      "properties": {
        "verified": {
          "type": "boolean"
        },
        "reference": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
